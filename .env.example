# Default Configuration
DEFAULT_CONFIG_FILE='./config/f_etacfg.json'
DEFAULT_SERVER='192.x.x.x:8080'

# Optional SQLite retention in days. 0 keeps all year-partitioned history.
DB_RETENTION_DAYS=0

# Optional token for non-browser write clients. Same-origin UI writes are allowed.
API_WRITE_TOKEN=

# Legacy escape hatch for unauthenticated cross-origin/non-browser writes.
ALLOW_UNAUTHENTICATED_WRITES=false
